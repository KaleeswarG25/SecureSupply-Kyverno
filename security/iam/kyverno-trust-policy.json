{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::<AWS_ACCOUNT_ID>:oidc-provider/<OIDC_PROVIDER_HOSTPATH>"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "<OIDC_PROVIDER_HOSTPATH>:aud": "sts.amazonaws.com",
          "<OIDC_PROVIDER_HOSTPATH>:sub": "system:serviceaccount:kyverno:kyverno-admission-controller"
        }
      }
    }
  ]
}
