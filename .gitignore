@'
# Local configuration / secrets
config/security.env
.env
.env.*
!.env.example

# Generated manifests
generated/

# Python
__pycache__/
.pytest_cache/
.venv/
*.pyc

# Logs
*.log

# Local Kubernetes / cloud credentials
.kube/
kubeconfig
*.kubeconfig

# Terraform local state
.terraform/
*.tfstate
*.tfstate.*
crash.log

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local certificates / keys
*.pem
*.key
*.p12
*.pfx
'@ | Set-Content .\.gitignore -Encoding UTF8