# Copy to config/security.env and fill every CHANGE_ME value.
# Never commit config/security.env.

AWS_ACCOUNT_ID=CHANGE_ME
AWS_REGION=ap-south-1
ECR_REGISTRY=CHANGE_ME.dkr.ecr.ap-south-1.amazonaws.com
ECR_REPOSITORY=securesupply
IMAGE_DIGEST=sha256:CHANGE_ME

# GitHub Actions keyless identity used by Cosign/Kyverno.
COSIGN_OIDC_ISSUER=https://token.actions.githubusercontent.com
COSIGN_IDENTITY_REGEXP=https://github\.com/KaleeswarG25/SecureSupply-Kyverno/.github/workflows/secure-build\.yml@refs/heads/main

# Optional branch/repository controls.
GITHUB_REPOSITORY=KaleeswarG25/SecureSupply-Kyverno
GITHUB_BRANCH=main

# Kyverno image registry matching.
ALLOWED_ECR_REGISTRY=CHANGE_ME.dkr.ecr.ap-south-1.amazonaws.com

# Argo CD GitOps.
ARGOCD_NAMESPACE=argocd
ARGOCD_APP_NAME=securesupply
GITOPS_REPO_URL=https://github.com/KaleeswarG25/SecureSupply-Kyverno.git
GITOPS_REVISION=main
